#!/bin/sh
if [ -n "${FAKE_DATE_HOLD:-}" ]; then
    : > "$FAKE_DATE_HOLD.reached"
    i=0
    while [ ! -e "$FAKE_DATE_HOLD" ] && [ "$i" -lt 200 ]; do
        sleep 0.05
        i=$((i + 1))
    done
fi
if [ -n "${FAKE_DATE_NOW:-}" ]; then
    echo "$FAKE_DATE_NOW"
    exit 0
fi
PATH=${PATH#*:} exec date "$@"
